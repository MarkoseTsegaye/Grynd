# Copy this file to `.env` and fill in the values from your Supabase project
# dashboard: https://supabase.com/dashboard/project/_/settings/api
#
# Vars prefixed with `EXPO_PUBLIC_` are inlined into the JS bundle at build
# time, so they're readable from client code but ALSO readable from the
# distributed bundle. That is fine for the anon key (Supabase's Row Level
# Security is what actually protects data) but do NOT put the service_role
# key here — that key bypasses RLS entirely and must stay server-only.
#
# For Vercel: set the same vars under Project Settings → Environment
# Variables. `npm run build:web` (which Vercel calls) reads them from the
# process env at build time.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
