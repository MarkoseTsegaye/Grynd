{
  "name": "my-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "cross-env APP_ENV=development npx expo start",
    "start:tunnel": "cross-env APP_ENV=development npx expo start --tunnel",
    "start:prod": "cross-env APP_ENV=production npx expo start",
    "android": "cross-env APP_ENV=development npx expo run:android",
    "ios": "cross-env APP_ENV=development npx expo run:ios",
    "build:prod": "cross-env APP_ENV=production eas build --profile production",
    "build:web": "cross-env APP_ENV=production npx expo export -p web",
    "vercel-build": "cross-env APP_ENV=production npx expo export -p web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ app/",
    "test": "vitest run",
    "test:watch": "vitest",
    "orchestrate": "node tools/orchestrator/orchestrate.mjs",
    "orchestrate:drain": "node tools/orchestrator/drain.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "^2.3.1",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "moment": "^2.30.1",
    "nativewind": "^4.2.4",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-any-picker": "^1.0.1",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.5.1",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@cursor/sdk": "^1.0.0",
    "@types/react": "~19.1.0",
    "@typescript-eslint/parser": "^8.44.0",
    "babel-preset-expo": "~54.0.10",
    "cross-env": "^10.1.0",
    "eslint": "^9.34.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vitest": "^3.2.6"
  },
  "private": true,
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
