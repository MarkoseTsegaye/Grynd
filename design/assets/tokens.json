{
  "_source": "Reconciled with src/shared/theme/colors.ts + typography.ts. Code is the source of truth.",
  "color": {
    "surface": {
      "surface-0": { "value": "#0A0A0A", "desc": "App background (near-black, warm)" },
      "surface-1": { "value": "#141414", "desc": "Raised card / bottom sheet" },
      "surface-2": { "value": "#1F1F1F", "desc": "Chip / segmented / divider border" }
    },
    "text": {
      "text-primary":   { "value": "#F0EDE8", "desc": "Primary (warm off-white)" },
      "text-secondary": { "value": "#8A8580", "desc": "Secondary + most captions/labels" },
      "text-disabled":  { "value": "#3D3B38", "desc": "Set labels, inactive, faint dots" }
    },
    "accent": {
      "accent":     { "value": "#E8FF47", "desc": "Brand lime" },
      "accent-dim": { "value": "#B8CC2E", "desc": "Muted accent / plot dots" },
      "onAccent":   { "value": "#0A0A0A", "desc": "Text on accent (= surface-0)" }
    },
    "semantic": {
      "success": { "value": "#3ECF6A", "desc": "Progression / up (▲)" },
      "danger":  { "value": "#FF4C4C", "desc": "To-failure / destructive" },
      "warning": { "value": "#FFB020" }
    },
    "derived": {
      "divider":   { "value": "surface-2", "desc": "Borders use surface-2 (no dedicated token)" },
      "danger-bg": { "value": "rgba(255,76,76,0.10)", "desc": "code: bg-danger/10" },
      "accent-bg": { "value": "rgba(232,255,71,0.10)", "desc": "code: bg-accent/10" }
    }
  },
  "radius": { "lg": 12, "sm": 8, "note": "Tailwind rounded-lg is the app default for cards/buttons/sheets" },
  "font": {
    "sans": "Inter_400Regular",
    "sansMedium": "Inter_500Medium",
    "sansBold": "Inter_700Bold",
    "mono": "JetBrainsMono_400Regular",
    "monoBold": "JetBrainsMono_700Bold"
  },
  "typeScale": {
    "xs": [14, 18], "sm": [16, 22], "base": [18, 26], "lg": [20, 30],
    "xl": [22, 30], "2xl": [26, 34], "3xl": [32, 38], "4xl": [40, 44]
  }
}
